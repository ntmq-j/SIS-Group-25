# Public Vite/Supabase configuration for local frontend development.
# Use the project URL and anon/public key only. Never put a service_role key
# or the database password in this file or in a browser bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
# Public Cloudflare Turnstile site key; never put the Turnstile secret here.
VITE_TURNSTILE_SITE_KEY=<cloudflare-turnstile-site-key>
